# Copia este archivo a .env.local y rellena los valores. .env.local nunca se commitea.

# Neon: cadena de conexión de la base de datos (Neon Console > Connect).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Auth: URL base del proyecto (Neon Console > Auth > Configuration).
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth

# Secreto para firmar las cookies de sesión: mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Opcional: API externa de ejercicios (src/lib/exerciseService.ts, hoy sin uso).
# NEXT_PUBLIC_EXERCISE_API_KEY=
# NEXT_PUBLIC_EXERCISE_API_HOST=
